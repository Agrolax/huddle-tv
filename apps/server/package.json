{
  "name": "@huddle/server",
  "version": "0.1.0",
  "private": true,
  "description": "Household API + WebSocket hub. Amazon Bedrock for Tonight, chat and quiz. Household state is in memory.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "TZ=UTC node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@huddle/shared": "0.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "~5.4.5"
  }
}
