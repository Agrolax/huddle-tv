PORT=8787
# HUDDLE_LAN_IP=192.168.1.20
# HUDDLE_WEATHER=off

# AI: "mock" (default, no AWS needed) or "bedrock" (Amazon Nova via the Converse API).
HUDDLE_AI=mock
AWS_REGION=us-east-1
# Credentials come from the default AWS chain (AWS_PROFILE, ~/.aws, or env keys). Never commit them.
# AWS_PROFILE=huddle
# HUDDLE_TONIGHT_MODEL=us.amazon.nova-lite-v1:0
# HUDDLE_CHAT_MODEL=us.amazon.nova-micro-v1:0
# HUDDLE_QUIZ_MODEL=us.amazon.nova-pro-v1:0
# Local dev: `aws login` gives the CLI and this server short-lived credentials from your console session.
# Tonight backdrops: Nova Canvas paints one per pick when HUDDLE_AI=bedrock. "off" lets the TV draw them.
# HUDDLE_ART=off
# HUDDLE_ART_MODEL=amazon.nova-canvas-v1:0

# Optional Tonight posters from TMDB (https://www.themoviedb.org/settings/api).
# Set one. TMDB_API_KEY is the short "API Key" (32 characters); TMDB_READ_TOKEN is the long
# "API Read Access Token" (starts with eyJ). Leave both unset to keep the drawn art.
# The key stays on the server. Never commit a real one.
# TMDB_API_KEY=
# TMDB_READ_TOKEN=
